        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Лучше смотрится на тонких начертаниях."
          }
        }
      }
    },
    "⚠️ Looks better at Regular weight or higher." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
