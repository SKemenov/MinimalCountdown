{
  "sourceLanguage" : "en",
  "strings" : {
    "⚠️ Looks better at lighter weights." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ يبدو أفضل مع أوزان أخف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Sieht bei dünneren Stärken besser aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Se ve mejor con grosores más finos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ با ضخامت‌های نازک‌تر بهتر به نظر می‌رسد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Plus joli avec des épaisseurs plus fines."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ נראה טוב יותר עם עוביים דקים יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ हल्की मोटाई में बेहतर दिखता है।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Лучше смотрится на тонких начертаниях."
          }
        },
        "sa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ लघु-स्थौल्येषु श्रेष्ठं दृश्यते।"
          }
        }
      }
    },
    "⚠️ Looks better at Regular weight or higher." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ يبدو أفضل مع وزن «عادي» أو أعلى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Sieht bei Stärke Normal oder höher besser aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Se ve mejor con el grosor Normal o superior."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ با ضخامت «معمولی» یا بیشتر بهتر به نظر می‌رسد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Plus joli à l’épaisseur Normale ou supérieure."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ נראה טוב יותר עם עובי «רגיל» ומעלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ नियमित या उससे अधिक मोटाई में बेहतर दिखता है।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Лучше смотрится при толщине Обычная или жирнее."
          }
        },
        "sa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ «सामान्य» स्थौल्यात् ऊर्ध्वं श्रेष्ठं दृश्यते।"
          }
        }
      }
    },
    "⚠️ Looks better with Rounded enabled." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ يبدو أفضل عند تفعيل التدوير."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
