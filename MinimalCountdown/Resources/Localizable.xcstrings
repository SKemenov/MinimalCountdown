{
  "sourceLanguage" : "en",
  "strings" : {
    "⚠️ Looks better at lighter weights." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Sieht bei dünneren Stärken besser aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Se ve mejor con grosores más finos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Plus joli avec des épaisseurs plus fines."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Лучше смотрится на тонких начертаниях."
          }
        }
      }
    },
    "⚠️ Looks better at Regular weight or higher." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Sieht bei Stärke Normal oder höher besser aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Se ve mejor con el grosor Normal o superior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Plus joli à l’épaisseur Normale ou supérieure."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Лучше смотрится при толщине Обычная или жирнее."
          }
        }
      }
    },
    "⚠️ Looks better with Rounded enabled." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Sieht mit aktivierter Rundung besser aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Se ve mejor con el redondeado activado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Plus joli avec l’arrondi activé."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Лучше смотрится со скруглением."
          }
        }
      }
    },
